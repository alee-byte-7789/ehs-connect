# Copy this file to .env and point it at your backend.
#
# Two different situations need two different values here:
#
# 1. LOCAL TESTING (Expo Go on your phone, or `expo start --web` on your
#    own machine) — "localhost" only works in a browser on the SAME
#    machine as the backend. Use your machine's LAN IP instead:
#      EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000/api/v1
#
# 2. VERCEL WEB BUILD (the unified deployment — see docs/DEPLOYMENT_SETUP.md)
#    — frontend and backend are served from the SAME domain there, so a
#    relative path works and is preferred (no hardcoded domain to update
#    later):
#      EXPO_PUBLIC_API_BASE_URL=/api/v1
#    This value is set directly in Vercel's project environment variables,
#    not in this file — Expo bakes EXPO_PUBLIC_* vars in at build time.
#
# The default below is for local testing only.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
