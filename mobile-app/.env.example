# Copy this file to .env and point it at your backend.
#
# "localhost" only works if you're running the app in a web browser on the
# SAME machine as the backend. For Expo Go on a physical phone, or the
# iOS PWA build, use your machine's LAN IP instead, e.g.:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
